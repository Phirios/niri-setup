 # --- server -------------------------------------------------------------------
 
+class WhisperCppModel:
+    """AMD/cross-vendor GPU transcription through whisper.cpp's Vulkan backend."""
+
+    def __init__(self, model_path, model_name):
+        self.model_path = model_path
+        self.model_name = model_name
+        self.cpu_model = None
+        self.prompt = ""
+
+    def _cpu_fallback(self, path, language, **options):
+        if self.cpu_model is None:
+            from faster_whisper import WhisperModel
+            print("Vulkan transcription unavailable; loading CPU/int8 fallback", file=sys.stderr, flush=True)
+            self.cpu_model = WhisperModel(self.model_name, device="cpu", compute_type="int8")
+        if self.prompt:
+            options["initial_prompt"] = self.prompt
+        return self.cpu_model.transcribe(path, language=language, **options)
+
+    def transcribe(self, path, language=None, **options):
+        command = [
+            WHISPER_CPP,
+            "--model", self.model_path,
+            "--file", path,
+            "--device", "0",
+            "--language", language or "auto",
+            "--no-timestamps",
+        ]
+        if self.prompt:
+            command.extend(["--prompt", self.prompt])
+        try:
+            result = subprocess.run(command, capture_output=True, text=True, timeout=120)
+            if result.returncode != 0:
+                detail = result.stderr.strip().splitlines()
+                raise RuntimeError(detail[-1] if detail else f"whisper.cpp exited {result.returncode}")
+
+            # Keep decisive backend evidence in the voice log without copying
+            # all model and timing output for every recorded chunk.
+            for line in result.stderr.splitlines():
+                if "ggml_vulkan: 0 =" in line or "using Vulkan0 backend" in line:
+                    print(line, file=sys.stderr, flush=True)
+            text = result.stdout.strip()
+            if text:
+                # Give the next short chunk enough context to continue names and
+                # sentence structure across the recording boundary.
+                self.prompt = (self.prompt + " " + text).strip()[-240:]
+            return [SimpleNamespace(text=text)] if text else [], None
+        except Exception as error:
+            print(f"Vulkan transcription failed ({error})", file=sys.stderr, flush=True)
+            return self._cpu_fallback(path, language, **options)
+
