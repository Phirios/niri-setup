+function normalize(token) {
+    const key = String(token).trim().toUpperCase();
+    const aliases = {CONTROL:"CTRL", "⌃":"CTRL", COMMAND:"SUPER", CMD:"SUPER", META:"SUPER", MOD:"SUPER", "⌘":"SUPER", OPTION:"ALT", "⌥":"ALT", "⇧":"SHIFT", ENTER:"RETURN", ESC:"ESCAPE", "/":"SLASH", "?":"SLASH", ",":"COMMA", " ":"SPACE"};
+    return aliases[key] || key;
+}
+function tokens(key) { return String(key).split("+").map(normalize).filter(Boolean); }
+function display(key) {
+    const labels = {SUPER:"⌘", CTRL:"⌃", ALT:"⌥", SHIFT:"⇧", RETURN:"Enter", SLASH:"/", COMMA:",", SPACE:"Space", "MOUSE:272":"Left click", "MOUSE:273":"Right click", WHEELSCROLLDOWN:"Wheel ↓", WHEELSCROLLUP:"Wheel ↑"};
+    return tokens(key).map(k => labels[k] || k).join(" ");
+}
+function matches(bind, category, query, keyQuery) {
+    if (keyQuery) {
+        const actual = tokens(bind.key || "");
+        return tokens(keyQuery).every(k => actual.includes(k));
+    }
+    const haystack = [bind.key, display(bind.key || ""), bind.desc, bind.action, category].join(" ").toLowerCase();
+    return String(query || "").trim().toLowerCase().split(/\s+/).every(word => haystack.includes(word));
+}
+
+function escapeHtml(text) {
+    return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+}
+function highlighted(text, query, keyQuery, isKey) {
+    const plain = String(text || "");
+    let words = [];
+    if (keyQuery && isKey)
+        words = tokens(keyQuery).map(k => display(k));
+    else if (!keyQuery)
+        words = String(query || "").trim().split(/\s+/).filter(Boolean).map(word => isKey && ["SUPER", "CTRL", "CONTROL", "ALT", "SHIFT", "COMMAND", "OPTION", "CMD", "META"].includes(word.toUpperCase()) ? display(word) : word);
+    const mask = Array(plain.length).fill(false);
+    const lower = plain.toLowerCase();
+    for (const word of words) {
+        if (!word) continue;
+        const needle = word.toLowerCase();
+        let pos = lower.indexOf(needle);
+        while (pos !== -1) {
+            for (let i = pos; i < pos + needle.length; i++) mask[i] = true;
+            pos = lower.indexOf(needle, pos + needle.length);
+        }
+    }
+    let result = "";
+    for (let start = 0; start < plain.length;) {
+        let end = start + 1;
+        while (end < plain.length && mask[end] === mask[start]) end++;
+        const part = escapeHtml(plain.slice(start, end));
+        result += mask[start] ? '<span style="color: #ffd34d; font-weight: 700">' + part + '</span>' : part;
+        start = end;
+    }
+    return result;
+}
