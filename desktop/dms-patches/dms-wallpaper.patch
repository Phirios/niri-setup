+    function normalizeLocalPath(path) {
+        let value = String(path || "").replace(/^file:\/\//, "");
+        try {
+            value = decodeURIComponent(value);
+        } catch (e) {
+        }
+        return value;
+    }
+
+    function pathsEqual(left, right) {
+        return normalizeLocalPath(left) === normalizeLocalPath(right);
+    }
+
+    function expandHome(path) {
+        const value = normalizeLocalPath(path);
+        const localHome = normalizeLocalPath(homeDir);
+        if (value === "~")
+            return localHome;
+        return value.indexOf("~/") === 0 ? localHome + value.slice(1) : value;
+    }
+
+    function isLiveWallpaperThumbnail(path) {
+        return /\.(mp4|webm|mkv|mov)\.jpg$/i.test(String(path || ""));
+    }
+
+    function videoPathForThumbnail(path) {
+        const fileName = String(path).substring(String(path).lastIndexOf('/') + 1);
+        return expandHome("~") + "/Videos/Wallpapers/" + fileName.replace(/\.jpg$/i, "");
+    }
+
+    function thumbnailPathForVideo(path) {
+        if (!path)
+            return "";
+        const fileName = String(path).substring(String(path).lastIndexOf('/') + 1);
+        return expandHome("~") + "/Pictures/Wallpapers/" + fileName + ".jpg";
+    }
+
+    function setBuiltInWallpaperDisabled(disabled) {
+        const prefs = SettingsData.screenPreferences || {};
+        const updated = Object.assign({}, prefs);
+        updated.wallpaper = disabled ? [] : ["all"];
+        SettingsData.set("screenPreferences", updated);
+    }
 
