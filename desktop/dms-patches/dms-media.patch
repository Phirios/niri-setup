+#!/usr/bin/env python3
+"""Fetch LRCLIB lyrics for the DMS hover player; stdout is one JSON object."""
+import json
+import math
+import re
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+
+
+def parse_lrc(text):
+    lines = []
+    for raw in text.splitlines():
+        tags = re.findall(r'\[(\d+):(\d+(?:\.\d+)?)\]', raw)
+        lyric = re.sub(r'\[[^\]]*\]', '', raw).strip()
+        for minutes, seconds in tags:
+            timestamp = int(minutes) * 60 + float(seconds)
+            if math.isfinite(timestamp):
+                lines.append({'time': timestamp, 'text': lyric})
+    return sorted(lines, key=lambda line: line['time'])
+
+
+def normalize(text):
+    return ' '.join(re.findall(r'\w+', text.casefold()))
+
+
+def fetch(title, artist, album, duration):
+    params = {'track_name': title, 'artist_name': artist}
+    if album:
+        params['album_name'] = album
+    if duration > 0:
+        params['duration'] = round(duration)
+    failed = False
+    for endpoint in ('get', 'search'):
+        query = params if endpoint == 'get' else {'track_name': title, 'artist_name': artist}
+        url = 'https://lrclib.net/api/' + endpoint + '?' + urllib.parse.urlencode(query)
+        try:
+            request = urllib.request.Request(url, headers={'User-Agent': 'DMS-HoverLyrics/1.0'})
+            with urllib.request.urlopen(request, timeout=8) as response:
+                data = json.load(response)
+            candidates = data if isinstance(data, list) else [data]
+            candidates = [item for item in candidates
+                          if normalize(item.get('trackName', '')) == normalize(title)
+                          and normalize(item.get('artistName', '')) == normalize(artist)
+                          and (duration <= 0 or abs(item.get('duration', 0) - duration) <= 4)]
+            candidates.sort(key=lambda item: (not bool(item.get('syncedLyrics')), abs(item.get('duration', 0) - duration)))
+            for item in candidates:
+                if item.get('instrumental'):
+                    return {'status': 'instrumental', 'lines': []}
+                lines = parse_lrc(item.get('syncedLyrics') or '')
+                if lines:
+                    return {'status': 'synced', 'lines': lines}
+                plain = item.get('plainLyrics')
+                if plain:
+                    return {'status': 'plain', 'lines': [{'time': -1, 'text': line} for line in plain.splitlines()]}
+        except urllib.error.HTTPError as error:
+            failed = failed or error.code != 404
+        except (OSError, ValueError, TypeError):
+            failed = True
+    return {'status': 'error' if failed else 'not_found', 'lines': []}
+
+
+if __name__ == '__main__':
+    try:
+        title, artist, album, duration = sys.argv[1:5]
+        result = fetch(title, artist, album, float(duration)) if title and artist else {'status': 'no_info', 'lines': []}
+    except (ValueError, TypeError):
+        result = {'status': 'error', 'lines': []}
+    print(json.dumps(result, ensure_ascii=False))
