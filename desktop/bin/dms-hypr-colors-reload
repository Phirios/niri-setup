#!/usr/bin/env python3
"""Reload config in any running Hyprland instances after DMS colors change."""

import json
import subprocess


instances = subprocess.run(
    ["hyprctl", "instances", "-j"], capture_output=True, text=True, check=True
)
for instance in json.loads(instances.stdout):
    subprocess.run(
        ["hyprctl", "--instance", instance["instance"], "reload", "config-only"],
        check=True,
    )
