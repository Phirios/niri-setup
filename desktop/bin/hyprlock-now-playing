#!/usr/bin/env python3
"""Print the current media title for the Hyprlock label."""

import html
import subprocess


try:
    result = subprocess.run(
        ["playerctl", "metadata", "--format", "{{artist}}|{{title}}"],
        capture_output=True,
        text=True,
        timeout=1,
        check=False,
    )
except (OSError, subprocess.TimeoutExpired):
    raise SystemExit(0)

if result.returncode == 0:
    artist, _, title = result.stdout.strip().partition("|")
    track = " — ".join(part for part in (artist.strip(), title.strip()) if part)
    if track:
        track = track[:72] + ("…" if len(track) > 72 else "")
        print("♫ " + html.escape(track))
