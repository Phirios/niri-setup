diff --git a/AgentService.qml b/AgentService.qml
index 9021875..3937b0a 100644
--- a/AgentService.qml
+++ b/AgentService.qml
@@ -24,7 +24,10 @@ Singleton {
         return I18n.t(uiLanguage, key, args);
     }
 
+    property string provider: "claude"
     property string claudeModel: "haiku"
+    // Empty follows the Codex CLI default selected for the signed-in account.
+    property string codexModel: ""
     property bool extendedThinking: false
     property string systemPrompt: "You are a concise desktop assistant on Linux with niri (Wayland compositor) and DankMaterialShell. " +
         "You work from an allowlist: niri window and workspace commands, dms ipc calls, gtk-launch, xdg-open, " +
@@ -564,6 +567,13 @@ Singleton {
     readonly property string historyScript: decodeURIComponent(String(Qt.resolvedUrl("history.py")).replace(/^file:\/\//, ""))
 
     function loadHistory() {
+        // The current panel history reader understands Claude Code transcripts.
+        // Codex still keeps context in the active session; its archived sessions
+        // simply stay out of this dropdown for now.
+        if (provider !== "claude") {
+            history = [];
+            return;
+        }
         runQuietExit(cdWorkDir + "python3 " + shellQuote(historyScript) + " list", function(output) {
             try { history = JSON.parse(String(output).trim()); } catch(e) { history = []; }
         });
@@ -572,6 +582,7 @@ Singleton {
     // Deleting a session removes its transcript from disk — there is no other
     // copy. Confirmation happens in the UI before either of these is called.
     function deleteSession(historySessionId) {
+        if (provider !== "claude") return;
         runQuietExit(cdWorkDir + "python3 " + shellQuote(historyScript) + " delete " + shellQuote(historySessionId), function() {
             // Wiping the session being displayed leaves the chat pointing at a
             // transcript that no longer exists, so it is reset to a fresh one.
@@ -581,6 +592,7 @@ Singleton {
     }
 
     function deleteAllSessions() {
+        if (provider !== "claude") return;
         runQuietExit(cdWorkDir + "python3 " + shellQuote(historyScript) + " delete-all", function() {
             clearMessages();
             loadHistory();
@@ -588,7 +600,7 @@ Singleton {
     }
 
     function resumeSession(historySessionId) {
-        if (busy) return;
+        if (busy || provider !== "claude") return;
         sessionId = historySessionId;
         messages = [];
         busy = true;
@@ -639,13 +651,26 @@ Singleton {
 
         var intent = detectIntent(text);
         if (intent) {
-            prefetchContext(intent, function(ctx) { callClaude(text + "\n" + ctx); });
+            prefetchContext(intent, function(ctx) { callAgent(text + "\n" + ctx); });
         } else {
             statusText = tr("status.thinking");
-            callClaude(text);
+            callAgent(text);
         }
     }
 
+    function chooseProvider(name) {
+        var next = name === "claude" ? "claude" : "codex";
+        if (provider === next) return;
+        provider = next;
+        clearMessages();
+        loadHistory();
+    }
+
+    function callAgent(prompt) {
+        if (provider === "claude") callClaude(prompt);
+        else callCodex(prompt);
+    }
+
     // --- Pre-fetch context ---
     function prefetchContext(intent, callback) {
         if (intent.intent === "goto") {
@@ -682,6 +707,7 @@ Singleton {
     // Output is read as stream-json, one event per line, so every tool call
     // shows up in the chat while the agent is still working.
     property var _claudeProcess: null
+    property string _runningProvider: ""
     property bool _gotResult: false
     property string _lastText: ""
     property var _toolNames: ({})
@@ -763,6 +789,7 @@ Singleton {
         _gotResult = false;
         _lastText = "";
         _toolNames = ({});
+        _runningProvider = "claude";
 
         // exec: bash is replaced by claude, so Cancel's SIGTERM reaches claude itself.
         var cmd = cdWorkDir + "exec claude -p"
@@ -779,10 +806,43 @@ Singleton {
         p.running = true;
     }
 
+    function callCodex(prompt) {
+        statusText = tr(extendedThinking ? "status.thinking" : "status.processing");
+        _gotResult = false;
+        _lastText = "";
+        _toolNames = ({});
+        _runningProvider = "codex";
+
+        // Ignore the user's Codex config and rules so this small desktop panel
+        // cannot inherit broader permissions. The first turn fixes the session
+        // to the read-only sandbox; resumed turns retain that session policy.
+        var common = " --json --ignore-user-config --ignore-rules --skip-git-repo-check";
+        var model = codexModel.trim() ? " --model " + shellQuote(codexModel.trim()) : "";
+        var fullPrompt = sessionId ? prompt : systemPrompt + "\n\nUSER REQUEST:\n" + prompt;
+        var cmd;
+        if (sessionId) {
+            cmd = cdWorkDir + "exec codex exec resume" + common + model
+                + " " + shellQuote(sessionId) + " - 2>/dev/null <<< " + shellQuote(fullPrompt);
+        } else {
+            cmd = cdWorkDir + "exec codex exec" + common
+                + " --sandbox read-only -C " + shellQuote(workDir) + model
+                + " - 2>/dev/null <<< " + shellQuote(fullPrompt);
+        }
+
+        var p = claudeRunner.createObject(root, { shellCmd: cmd });
+        _claudeProcess = p;
+        p.running = true;
+    }
+
     function handleStreamLine(line) {
         var ev;
         try { ev = JSON.parse(line); } catch(e) { return; }
 
+        if (_runningProvider === "codex") {
+            handleCodexStreamEvent(ev);
+            return;
+        }
+
         var content = ev.message && Array.isArray(ev.message.content) ? ev.message.content : [];
 
         if (ev.type === "assistant") {
@@ -818,6 +878,59 @@ Singleton {
         }
     }
 
+    function handleCodexStreamEvent(ev) {
+        if (ev.type === "thread.started") {
+            if (ev.thread_id) sessionId = ev.thread_id;
+            return;
+        }
+
+        var item = ev.item || {};
+        if (ev.type === "item.started") {
+            if (item.type === "command_execution") {
+                var command = item.command || "command";
+                var step = describeTool("Command", { command: command });
+                addMessage("tool_status", step);
+                statusText = step;
+            } else if (item.type === "web_search") {
+                addMessage("tool_status", "Web search");
+                statusText = "Web search";
+            } else {
+                statusText = tr("status.thinking");
+            }
+            return;
+        }
+
+        if (ev.type === "item.completed") {
+            if (item.type === "agent_message" && item.text) {
+                _lastText = item.text;
+                statusText = tr("status.writing");
+            } else if (item.type === "command_execution" && item.exit_code !== undefined && item.exit_code !== 0) {
+                addMessage("tool_status", "✗ Command failed (exit " + item.exit_code + ")");
+            }
+            return;
+        }
+
+        if (ev.type === "turn.completed") {
+            _gotResult = true;
+            _claudeProcess = null;
+            lastCost = "";
+            if (ev.usage) {
+                var inp = ev.usage.input_tokens || 0;
+                var out = ev.usage.output_tokens || 0;
+                lastCost = inp + "→" + out + " tokens";
+            }
+            finishResponse(_lastText || "(done)");
+            return;
+        }
+
+        if (ev.type === "turn.failed" || ev.type === "error") {
+            _gotResult = true;
+            _claudeProcess = null;
+            var message = ev.message || (ev.error && ev.error.message) || "Codex request failed";
+            finishResponse("(error: " + message + ")");
+        }
+    }
+
     // One line per tool call: name plus the most telling argument.
     function describeTool(name, input) {
         var inp = input || {};
