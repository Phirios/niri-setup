// Keep the live wallpaper anchored to the output while niri animates between workspaces.
// place-within-backdrop only works on background-layer surfaces, so the plugin draws there.
// DMS already gives the workspace view a transparent background, so the backdrop
// remains visible instead of moving with each workspace.
layer-rule {
    match namespace="^dms:live-wallpaper$"
    place-within-backdrop true
}
