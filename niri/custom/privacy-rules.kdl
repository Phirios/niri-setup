// Hidden from screen shares and recordings. You still see these on your own screen;
// viewers see a black rectangle in their place. Screenshots are not affected.

// Shell surfaces that can show private text. Niri blacks out a whole surface, so each name
// is matched exactly: DMS pairs these panels with a full-screen click catcher named
// "<panel>:background" or "<panel>:clickcatcher", and hiding that blacks out everything.
layer-rule {
    match namespace="^dms:agent$"
    match namespace="^dms:notification-popup$"
    match namespace="^dms:notification-center-popout$"
    match namespace="^dms:notification-center-modal$"
    match namespace="^dms:clipboard$"
    match namespace="^dms:clipboard-popout$"
    block-out-from "screencast"
}

// Password dialogs also cover the whole screen, but only for the moment a password is typed.
layer-rule {
    match namespace="^dms:wifi-"
    match namespace="^dms:polkit-auth-surface$"
    block-out-from "screencast"
}

// Apps. Add a line per app; `niri msg windows` prints the app id of everything open.
window-rule {
    match app-id=r#"^gcr-prompter$"#
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    match app-id=r#"^[Bb]itwarden$"#
    match app-id=r#"^1[Pp]assword$"#
    block-out-from "screencast"
}
