+    // Ayatana tray items (Steam, Spotify) ignore Activate, so a left click did nothing.
+    // Focus the app's open window first, then raise it through MPRIS, then fall back to Activate.
+    function trayAppKey(trayItem) {
+        return (trayItem?.id || trayItem?.title || "").toLowerCase().replace(/([-_]client|_status_icon_\d+)$/, "");
+    }
+
+    function activateTrayItem(trayItem) {
+        const key = root.trayAppKey(trayItem);
+        if (key) {
+            const win = NiriService.windows.find(w => (w.app_id || "").toLowerCase() === key);
+            if (win) {
+                NiriService.focusWindow(win.id);
+                return;
+            }
+            const player = Mpris.players.values.find(p => p.canRaise && ((p.desktopEntry || "").toLowerCase().includes(key) || (p.identity || "").toLowerCase() === key));
+            if (player) {
+                player.raise();
+                return;
+            }
+        }
+        trayItem.activate();
+    }
